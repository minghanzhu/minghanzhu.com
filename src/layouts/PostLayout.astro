---
import { profile } from "../data/profile";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const { title, description, date, updated, image, readingTime } = frontmatter;

const published = new Date(date);
const formatted = published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const url = new URL(Astro.url.pathname, Astro.site).toString();

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: published.toISOString(),
  dateModified: new Date(updated ?? date).toISOString(),
  image: image ? new URL(image, Astro.site).toString() : undefined,
  mainEntityOfPage: url,
  author: {
    "@type": "Person",
    name: "Minghan (Max) Zhu",
    url: Astro.site?.toString(),
    sameAs: [profile.orcid, profile.linkedin, profile.scholar],
  },
};
---

<BaseLayout title={`${title} | Max Zhu`} description={description} image={image} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
  <article class="wrap narrow post">
    <header class="post-head">
      <p class="kicker"><a href="/writing/">Writing</a></p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="post-meta">{profile.name} · <time datetime={published.toISOString()}>{formatted}</time>{readingTime && ` · ${readingTime}`}</p>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>
