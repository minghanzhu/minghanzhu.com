---
import PublicationItem from "../components/PublicationItem.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TagList from "../components/TagList.astro";
import { profile, publications, research } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="kicker">{profile.headline}</p>
      <h1>{profile.name}</h1>
      <p class="lede">{profile.intro}</p>
      <div class="actions">
        <a class="button primary" href="/research/">View research</a>
        <a class="button" href="/cv/">CV</a>
      </div>
      <p class="links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <span aria-hidden="true">·</span>
        <a href={profile.linkedin}>LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={profile.scholar}>Google Scholar</a>
        <span aria-hidden="true">·</span>
        <a href={profile.github}>GitHub</a>
        <span aria-hidden="true">·</span>
        <a href={profile.affiliations[0].url}>UCSF Weill Institute</a>
      </p>
    </div>
    <img class="portrait" src={profile.profileImage} alt={profile.profileImageAlt} loading="eager" />
  </section>

  <div class="wrap">
    <img
      class="banner"
      src={profile.heroImage}
      alt="UCSF neurosurgeon Philip Starr implanting a deep brain stimulation electrode."
      loading="eager"
    />
  </div>

  <section class="stats" aria-label="At a glance">
    <div class="wrap stats-grid">
      {profile.quickStats.map((stat) => (
        <div>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap narrow section">
    <SectionHeading label="Research" href="/research/" />
    <div class="prose">
      <p>{profile.bio[0]}</p>
      <p>{profile.motivation}</p>
    </div>
    <div class="stack">
      {research.slice(0, 2).map((item) => (
        <article class="card">
          <p class="meta">{item.dates}</p>
          <h3>{item.title} <span class="muted">· {item.lab}</span></h3>
          <p>{item.summary}</p>
          <TagList items={item.tags} />
        </article>
      ))}
    </div>
  </section>

  <section class="wrap narrow section">
    <SectionHeading label="Publications" href="/research/#publications" />
    <div class="pub-list">
      {publications.map((item) => <PublicationItem item={item} />)}
    </div>
  </section>
</BaseLayout>
